# Alma — образ бэкенда.
#
# Две стадии, и вторая не содержит ничего, чем собирали первую. Это не
# эстетика: компилятор, заголовки и кэш pip — это ~350 МБ и, что важнее,
# инструменты сборки внутри процесса, смотрящего в интернет. Собранное
# виртуальное окружение переносится целиком, а всё, чем его собирали, остаётся
# в отброшенной стадии.
#
# Что здесь запечено намеренно, хотя выглядит как данные:
#   data/de440s.bsp      — эфемериды JPL, 31 МБ, без них нет ни одного расчёта;
#   data/places.sqlite   — индекс мест, 25 МБ, без него /v1/places отвечает 503;
#   data/chiron_2060.npz — Хирон;
#   static/plates        — вклейки глав, 2.4 МБ.
# Все четыре лежат в репозитории и меняются вместе с кодом, поэтому их место —
# в образе, а не в томе: том пришлось бы наполнять отдельным ритуалом, и первый
# же забытый ритуал — это сервис, который поднялся и не умеет считать.

# ─────────────────────────────────────────────────────────────────────────────
# 1. Сборка
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Колёса под cp312/manylinux есть у всего, что мы ставим (numpy, cryptography,
# skyfield), поэтому компилятор в обычном случае не нужен. Он здесь на случай
# зависимости, у которой колеса не окажется: без него такая сборка падает с
# «error: command 'gcc' failed», и разбирать это в шесть утра на выкатке —
# худшее время. Стадия отбрасывается целиком, так что цена — минуты сборки.
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /build

# Сначала только манифест — слой с зависимостями переживает правку кода.
# Правка одной строки в alma/ пересобирает последние два слоя, а не весь pip.
COPY pyproject.toml README.md ./
COPY alma/__init__.py alma/__init__.py
# `[postgres]` — это asyncpg, и он обязателен: прод отказывается стартовать не
# на Postgres (`config.check_production_ready`), а без драйвера URL Postgres не
# открывается вовсе. `gunicorn` не в pyproject, потому что это способ запуска, а
# не зависимость библиотеки: `pip install -e backend` на машине разработчика не
# должен тянуть менеджер процессов.
RUN pip install --upgrade pip \
 && pip install ".[postgres]" gunicorn

COPY . /build
RUN pip install --no-deps .

# ─────────────────────────────────────────────────────────────────────────────
# 2. Выполнение
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

# PYTHONUNBUFFERED — чтобы `docker compose logs` показывал строку в момент, когда
# она написана, а не когда наберётся буфер. Для процесса, за которым смотрят
# только через логи, это разница между «видно» и «не видно».
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    # Замки регулярных прогонов — на записываемый том, а не в /app.
    # См. `notify/daily.single_run`.
    ALMA_RUN_LOCK_DIR=/var/lib/alma

# **Непривилегированный пользователь, и он создаётся до COPY.** Процесс,
# смотрящий в интернет, не должен иметь права переписать собственный код: если
# уязвимость в зависимости даёт запись на диск, разница между root и alma —
# это разница между «испорчен один том» и «в образ дописан бэкдор, который
# переживёт перезапуск». Каталоги приложения остаются принадлежать root и
# доступны alma только на чтение; на запись — единственный том ниже.
RUN groupadd --system --gid 10001 alma \
 && useradd --system --uid 10001 --gid alma --home-dir /app --shell /usr/sbin/nologin alma

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY --chown=root:root alma ./alma
COPY --chown=root:root data ./data
COPY --chown=root:root static ./static
COPY --chown=root:root gunicorn.conf.py ./gunicorn.conf.py
# Миграция и чистка — шаги выкладки, а не разработки: их зовут внутри этого
# образа (`docs/DEPLOY.md` §2 и §5). Без этой строки чистый сервер не встаёт:
# схему на старте больше никто не создаёт, а создать её нечем.
COPY --chown=root:root tools ./tools

# Единственное записываемое место. Сюда же compose монтирует именованный том,
# так что замок прогона переживает пересборку образа и не переживает падение
# машины — ровно то поведение, которое `single_run` описывает.
RUN mkdir -p /var/lib/alma && chown alma:alma /var/lib/alma
VOLUME ["/var/lib/alma"]

USER alma
EXPOSE 8000

# **`/health`, а не `/ready`, и это решение, а не описка.** `/health` отвечает
# «процесс жив»; `/ready` отвечает «настроено всё, что сервис обещает», и с тех
# пор как в него входят ключ модели и процессор (`api/routers/health.py`),
# развёртывание без кассы честно говорит `ready: false`. Проверка живости по
# нему перезапускала бы в петле совершенно исправный процесс.
#
# start-period 40s: первый запрос поднимает ядро эфемерид (31 МБ) и индекс мест
# (25 МБ). На холодной машине это единицы секунд, но на медленном диске — не
# единицы, и контейнер, объявленный больным на старте, перезапускается в петле,
# ни разу не дойдя до готовности.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD ["python", "-c", "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)"]

CMD ["gunicorn", "alma.api.app:app", "-c", "gunicorn.conf.py"]
