# Обратный прокси перед Alma. Используется службой `proxy` в docker-compose.yml.
#
# Caddy сам получает и продлевает сертификат Let's Encrypt: достаточно, чтобы
# {$ALMA_DOMAIN} указывал A-записью на эту машину и чтобы порты 80 и 443 были
# открыты. Проверка ACME ходит по 80-му — закрыть его «за ненадобностью»
# значит остаться без продления на девяностый день.

{
	# Почта на случай, если Let's Encrypt понадобится о чём-то предупредить —
	# например, что продление не удаётся. Пусто — Caddy обходится, но письма
	# «ваш сертификат истекает» тогда никуда не приходят.
	email {$ALMA_ACME_EMAIL}

	# Сервер не представляется версией. Мелочь, и стоит одной строки.
	servers {
		protocols h1 h2 h3
	}
}

{$ALMA_DOMAIN} {
	encode zstd gzip

	# ── вклейки глав: отдаёт прокси, приложение не будит ────────────────────
	#
	# Это статические картинки по 100–200 КБ. Каждая, прошедшая через
	# приложение, занимает воркера gunicorn на время передачи по мобильной
	# сети — то есть на секунды, — и ровно этого воркера в этот момент не
	# хватает тому, кто ждёт главу. Отдача прокси стоит нам нуля.
	#
	# `immutable`: содержимое под именем не меняется никогда, новая картинка
	# приезжает новым `?v=` в ссылке (`api/plates.py`). Значит, браузер может
	# не спрашивать про неё год.
	handle_path /static/plates/* {
		root * /srv/alma/static/plates
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# ── поток стадий: без буферизации и с долгим ожиданием ──────────────────
	#
	# `/v1/chat/stream` — это SSE: приложение шлёт стадии («считаю карту»,
	# «пишу») по мере того, как они происходят, и пауза между двумя стадиями —
	# это модель, которая думает, то есть до трёх минут (`ai/provider.py`).
	#
	# Две вещи ломают такой поток, и обе — умолчания прокси:
	#   • буферизация: прокси копит ответ и отдаёт целиком, поэтому читатель
	#     видит пустой экран всё время генерации, а потом всё сразу;
	#   • таймаут чтения: тишина дольше минуты читается как обрыв, и соединение
	#     закрывается посреди оплаченной генерации.
	# `flush_interval -1` выключает первую, `read_timeout` лечит вторую.
	@stream path /v1/chat/stream*
	handle @stream {
		reverse_proxy app:8000 {
			flush_interval -1
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
			header_up X-Real-IP {remote_host}
		}
	}

	# ── всё остальное ───────────────────────────────────────────────────────
	handle {
		reverse_proxy app:8000 {
			transport http {
				read_timeout 180s
				write_timeout 180s
			}

			# **`X-Real-IP` — не украшение журнала.** `api/deps.request_source`
			# читает именно его (и только перезаписываемые краем заголовки —
			# `X-Forwarded-For` намеренно не читается, потому что прокси его
			# *дописывают*, и первый элемент цепочки сочиняет клиент). Без этой
			# строки все запросы мира приходят с адреса контейнера прокси, то
			# есть складываются в один ключ, и потолок по источнику начинает
			# бить по живым людям вместо скрипта. `{remote_host}` — адрес
			# сокета, который видит Caddy, то есть настоящий адрес клиента, а
			# не то, что клиент о себе написал.
			header_up X-Real-IP {remote_host}
		}
	}

	# Заголовки безопасности. HSTS ставится только когда домен настоящий:
	# на localhost он запирает браузер на https к localhost на год.
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format console
	}
}
