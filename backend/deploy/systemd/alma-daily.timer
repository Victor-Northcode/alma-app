[Unit]
Description=Alma — утренняя рассылка; ежечасно, шлёт тем, у кого местные 10:00

[Timer]
# Каждый час ровно. Задание само выбирает тех, у кого сейчас утро, и само
# следит, чтобы человек получил не больше одной записи в день — строка в
# `usage_counter` захватывается до отправки (`notify/daily.claim`).
OnCalendar=*-*-* *:00:00

# **Пропущенный час догоняется при возвращении машины.** Ровно то свойство,
# которого нет у crontab: коробка, лежавшая в 10:17, просто пропустила бы день.
Persistent=true

# Чтобы три задания не стартовали в одну и ту же секунду вечно.
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
