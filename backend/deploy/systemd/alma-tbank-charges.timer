[Unit]
Description=Alma — списание продлений Т-Банка; раз в сутки

[Timer]
# 10:43 UTC — 13:43 по Москве: покупатели этой витрины в России, и списание
# днём даёт человеку заметить письмо банка и успеть отменить до следующего
# раза; ночное списание — жалоба в поддержку утром. Не круглый час — круглые
# часы это когда просыпается весь интернет.
OnCalendar=*-*-* 10:43:00
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
