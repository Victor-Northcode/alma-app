# Что не попадает в контекст сборки.
#
# Первая строка списка — секреты, и она первая не случайно. `.env` попадает в
# слой образа, слой уходит в реестр, а из реестра его достаёт кто угодно, у кого
# есть образ. Правило `!.env.example` ниже — ровно то же, что в `.gitignore`:
# пример нужен, содержимое — никогда.
.env
.env.*
!.env.example

# Виртуальное окружение разработчика: собрано под macOS/arm, внутри
# linux-контейнера не работает, а весит сотни мегабайт. Образ ставит своё.
.venv/
*.egg-info/

# Кэши и результаты прогонов — это не то, что должно попасть в прод-образ.
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
nohup.out

# Тесты не запускаются внутри прод-образа; для них есть гейт на машине сборки.
tests/
tools/

# Локальные базы. Эфемериды (`de440s.bsp`), индекс мест (`places.sqlite`) и
# Хирон **остаются** — они нужны каждому расчёту, — а рабочая база разработчика
# нет: она чужие строки и мегабайты, и SQLite в проде всё равно запрещён
# (`config.check_production_ready`).
data/*.db
data/*.db-wal
data/*.db-shm
data/*.before-migration-*
data/*.lock

# Свои же артефакты развёртывания: конфигурация прокси и юниты systemd живут на
# хосте, а не внутри контейнера приложения.
deploy/
Dockerfile
docker-compose.yml
.dockerignore
