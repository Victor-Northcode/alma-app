# Alma — environment.
#
# Copy to `.env.local` and fill in. Nothing in this file is a real secret and
# nothing real is ever committed: every key below is read from the process
# environment at startup, and the service tells you which ones are missing at
# GET /ready rather than failing later in front of a customer.

# ── service ───────────────────────────────────────────────────────────────
ALMA_ENV=development
ALMA_BASE_URL=http://localhost:8000
ALMA_WEB_URL=http://localhost:3000
ALMA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── storage ───────────────────────────────────────────────────────────────
# SQLite in development; swap for postgresql+asyncpg://… in production.
# ALMA_DATABASE_URL=postgresql+asyncpg://user:password@host/alma

# ── sessions ──────────────────────────────────────────────────────────────
# REQUIRED in production. The service refuses to boot in production while
# this is still the development default — every session token would be
# forgeable. Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
ALMA_JWT_SECRET=

# ── sign-in ───────────────────────────────────────────────────────────────
# At least one of these. Without any, nobody can create an account.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
RESEND_API_KEY=
ALMA_MAIL_FROM=alma@yourdomain.com

# ── AI ────────────────────────────────────────────────────────────────────
# Readings and chat need this. Everything else — all eight calculations —
# works without it.
ANTHROPIC_API_KEY=
# Three tiers, not two. The free sample chapter sits between two impossible
# options: the cheapest model cannot write something good enough to sell the
# paid chapter, and the dearest cannot fit inside ALMA_FREE_USER_BUDGET.
ALMA_MODEL_STRONG=claude-opus-5
ALMA_MODEL_MID=claude-sonnet-5
ALMA_MODEL_CHEAP=claude-haiku-4-5

# Hard ceilings in US dollars, enforced before each call rather than
# discovered on the invoice. These two bound a single generation.
ALMA_FREE_USER_BUDGET=0.05
ALMA_FULL_REPORT_BUDGET=0.50

# ...and these three bound one account across a calendar month, which is the
# only thing that catches a thousand individually-cheap calls. They must not
# cross — Settings refuses to load if free > owner > subscriber, because an
# upgrade that buys somebody less than they had is found out mid-sentence.
# Each has to clear its own tier's advertised allowance; the arithmetic is in
# config.py and is pinned by a test.
ALMA_FREE_MONTH_BUDGET=1.00
ALMA_OWNER_MONTH_BUDGET=3.00
ALMA_SUBSCRIBER_MONTH_BUDGET=3.50

# ── billing ───────────────────────────────────────────────────────────────
# Which processor takes the money: "paddle", "dodo", "appstore" or
# "googleplay". The last two are how this ships: Apple's and Google's own
# guidelines permit our category outright, where Paddle's acceptable-use policy
# prohibits it and FastSpring's and 2Checkout's copy the clause. They are also
# merchants of record, which is what removes the EU OSS registration, the
# Brazilian CNPJ and the US state registrations.
#
# One word, and it decides two things: who takes the money on the web, and
# whose notifications /v1/billing/webhook is prepared to verify. It does **not**
# decide which stores /v1/billing/iap/verify will accept a purchase from — one
# backend answers an iOS app and an Android app at once, and that endpoint
# resolves its adapter from the platform in the request. So a deployment
# serving both apps fills in both store blocks and picks whichever store's
# notifications this instance receives.
#
# Fill in that one's
# block below and leave the other empty. Two rules the service enforces at
# boot rather than at the first customer: a name it does not ship refuses to
# start (a typo must not quietly route real money through the default), and so
# does half a block — an API key with no webhook secret opens checkouts that
# can never be verified into a grant, so the money arrives and the reading
# does not. All of it empty is fine: every calculation works without a
# processor and the checkout answers 503 naming what is missing.
ALMA_BILLING_PROVIDER=paddle

# The frontend needs the same word, as NEXT_PUBLIC_BILLING_PROVIDER, so the
# legal pages name the merchant of record who actually took the money.
#
# Neither processor can sell anything until the catalogue carries its product
# identifiers. `PRODUCTS[key].processor_ids` in alma/billing/catalogue.py is
# `{}` for every row — they come out of a processor's dashboard, so filling
# them in is the one step that cannot be done before an account exists. Until
# then the checkout refuses by name rather than opening a session against an
# identifier nobody set.

# The webhook secret is what stops anyone who can POST to /v1/billing/webhook
# from granting themselves everything. There is no fallback if it is unset:
# the endpoint refuses every request.
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox

# Dodo. Their own variable names, so a value copied from their dashboard
# lands in the right place. There is no equivalent of PADDLE_CLIENT_TOKEN:
# Dodo's server creates the checkout session and hands back a URL, so the
# browser never holds a publishable key or a price identifier.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Apple. One line, and it is not a secret — the bundle id is public and is in
# every copy of the app. There is no shared key with the App Store at all: a
# StoreKit transaction is a JWS signed by a certificate chain rooting in Apple
# Root CA - G3, which is pinned in alma/billing/appstore.py. What this does is
# answer the other question. A valid Apple signature proves Apple signed it,
# not that it is ours, and Apple signs a transaction for every app on the
# store — so somebody's 99c flashlight purchase POSTed to /v1/billing/iap/verify
# is a genuine signature over a genuine purchase, and this line is the whole of
# what refuses it.
APPLE_BUNDLE_ID=

# Whether a Sandbox-signed transaction may grant. Leave it true: App Review
# runs the production build against sandbox StoreKit accounts, so turning it
# off is a rejected app. The cost of leaving it on is real — anyone who can
# create a sandbox tester for this bundle can mint purchases that verify — and
# what makes it survivable is that the environment is recorded on every event.
ALMA_APPLE_ACCEPT_SANDBOX=true

# Google. Unlike Apple's, a Play purchase token proves nothing on its own: it
# is a key into Google's database, so verifying one means calling the Play
# Developer API as us. The JSON may be the credentials themselves or a path to
# a file holding them — a secret store hands over a string, a mounted volume
# hands over a path — and the first character says which.
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# The audience on the Pub/Sub push subscription that delivers Real-time
# Developer Notifications, and in practice a shared secret. The notification
# body is not signed; what is signed is the OIDC token Pub/Sub puts in the
# Authorization header, and Google will mint a valid one for any of its
# customers — so the signature alone proves only that somebody with a Google
# account sent it. This claim is configured on our subscription and nowhere
# else, which is what makes a delivery ours. Set the service account too: with
# it, an audience leaking from a proxy log is no longer enough on its own.
GOOGLE_PLAY_PUBSUB_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT=

# What our products are called in App Store Connect and the Play Console. This
# is the one place a store differs from a card processor in our favour: a price
# id is *issued* by a processor and has to be copied out of a dashboard, while
# a store product id is *chosen* — so it is computed from the catalogue key
# rather than being a second table to keep in agreement. `natal` becomes
# `alma.natal`, `birth-card` becomes `alma.birth_card` (neither console accepts
# a hyphen). Create the products under exactly those ids.
ALMA_STORE_PRODUCT_PREFIX=alma.

# The notice before a renewal is a scheduled job, not a request handler, and
# nothing in this process starts it. Run it once a day:
#
#     python -m alma.billing.renewals
#
# It looks for plans billing in about three days and writes to each once. The
# window is two days wide, so a day the job does not run costs a retry rather
# than the notice — but a month it never runs is a month of people charged
# without the warning four shipped surfaces promise them. RESEND_API_KEY has to
# be set or it sends nothing and says so in the log.

# ── limits ────────────────────────────────────────────────────────────────
# The three chat allowances. Free is three a day forever, on the cheapest
# model, because that is what makes the product feel alive to somebody who has
# not paid. Each of these has to fit inside its tier's monthly ceiling above —
# fifty a day did not, by an order of magnitude, so what actually stopped an
# owner was the ledger rather than the number they had been told.
ALMA_FREE_QUESTIONS=3
ALMA_PAID_QUESTIONS=5
ALMA_SUBSCRIBER_QUESTIONS=70
