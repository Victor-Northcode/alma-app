    "paywall.notVerified": {
      "comment": "401 invalid_transaction. Rare, and worth an alert on our side.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kauf konnte nicht bestätigt werden, deshalb wurde nichts geöffnet. Falls Apple abgebucht hat, schreib uns und wir klären das."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That purchase could not be verified, so nothing has been opened. If Apple charged you, write to us and we will sort it out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido verificar esa compra, así que no se ha abierto nada. Si Apple te cobró, escríbenos y lo resolvemos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet achat n'a pas pu être vérifié, donc rien n'a été ouvert. Si Apple t'a débité, écris-nous et on règle ça."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile verificare quell'acquisto, quindi non è stato aperto nulla. Se Apple ha addebitato, scrivici e sistemiamo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar essa compra, então nada foi aberto. Se a Apple cobrou, escreva para a gente e resolvemos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту покупку не удалось проверить, поэтому ничего не открылось. Если Apple списал деньги — напиши нам, и мы разберёмся."
          }
        }
      }
    },
    "paywall.offline": {
      "comment": "No network between the tap and our server.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma antwortet gerade nicht, deshalb konnte der Kauf nicht bestätigt werden. Er öffnet sich von selbst, sobald sie es tut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma is not answering right now, so the purchase could not be confirmed. It will open by itself once she does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma no responde ahora mismo, así que no se ha podido confirmar la compra. Se abrirá sola cuando responda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma ne répond pas pour l'instant, l'achat n'a donc pas pu être confirmé. Il s'ouvrira tout seul dès qu'elle répondra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma non risponde in questo momento, quindi l'acquisto non è stato confermato. Si aprirà da solo appena risponde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Alma não está respondendo agora, então a compra não pôde ser confirmada. Vai abrir sozinha assim que ela responder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma сейчас не отвечает, поэтому покупка не подтвердилась. Всё откроется само, как только связь вернётся."
          }
        }
      }
    },
    "paywall.oneTimeFine": {
      "comment": "Fine print under a one-time purchase. journey.offerFine.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zahlung. Dauerhaft deins. Zum Kaufen brauchst du kein Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One payment. Yours permanently. No account needed to buy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo pago. Tuyo para siempre. No hace falta cuenta para comprar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul paiement. À toi définitivement. Aucun compte requis pour acheter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pagamento solo. Tuo per sempre. Per comprare non serve un account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pagamento só. Seu para sempre. Não precisa de conta para comprar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один платёж. Твоё навсегда. Для покупки не нужен аккаунт."
          }
        }
      }
    },
