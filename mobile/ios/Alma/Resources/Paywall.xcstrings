          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "отмена в настройках Apple ID"
          }
        }
      }
    },
    "paywall.honestyOnce": {
      "comment": "First line of the honesty plate. pricing.honesty[0].",
      "extractionState": "manual",
      "localizations": {
        "de": {
