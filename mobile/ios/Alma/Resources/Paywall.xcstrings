    "paywall.storeUnavailable": {
      "comment": "StoreKit gave us no products. Without a price from Apple there is nothing honest to show.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store antwortet nicht. Bis dahin lässt sich hier nichts kaufen — und an dem, was dir schon gehört, ändert das nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store is not answering. Nothing here can be bought until it does — and nothing you already own has changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La App Store no responde. Aquí no se puede comprar nada hasta que responda — y nada de lo que ya tienes ha cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store ne répond pas. Rien ne peut être acheté ici tant qu'il ne répond pas — et rien de ce que tu possèdes déjà ne change."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store non risponde. Qui non si può comprare nulla finché non risponde — e quello che possiedi già non cambia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não está respondendo. Nada pode ser comprado aqui até que responda — e nada do que você já tem mudou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store не отвечает. Пока он молчит, здесь ничего нельзя купить — и ничего из уже купленного не изменилось."
          }
        }
      }
    },
