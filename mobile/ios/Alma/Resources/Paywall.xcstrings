          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "pagamento único é pagamento único"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "разовое — значит разовое"
          }
        }
      }
    },
    "paywall.honestySeller": {
      "comment": "Second line. The web app promises an email before renewal, which is our webhook's job and not ours on a store.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple zieht ein und schickt den Beleg"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple takes the payment and sends the receipt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple cobra y envía el recibo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple encaisse et envoie le reçu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple incassa e manda la ricevuta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "a Apple cobra e envia o recibo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple принимает платёж и присылает чек"
          }
        }
      }
    },
    "paywall.label": {
