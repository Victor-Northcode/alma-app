    "paywall.restoredOther": {
      "comment": "A restore that found purchases already claimed by a different Alma account. The fix is signing in, not a second grant.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Käufe gehören bereits einem anderen Alma-Konto. Melde dich mit diesem an, dann kommen sie mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These purchases already belong to another Alma account. Sign in with that one and they come with you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas compras ya pertenecen a otra cuenta de Alma. Inicia sesión con esa y vienen contigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces achats appartiennent déjà à un autre compte Alma. Connecte-toi avec celui-là et ils te suivent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi acquisti appartengono già a un altro account Alma. Accedi con quello e ti seguono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas compras já pertencem a outra conta Alma. Entre com ela e elas vêm junto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти покупки уже принадлежат другому аккаунту Alma. Войди в него — и они придут с тобой."
          }
        }
      }
    },
