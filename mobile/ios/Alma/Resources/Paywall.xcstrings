{
  "sourceLanguage": "en",
  "strings": {
    "paywall.annualNote": {
      "comment": "Under the annual row. pricing.renewsNote, corrected: on iOS cancelling is not two taps in our Settings.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich jedes Jahr, bis du kündigst. Kündigen kannst du jederzeit in deinen Apple-ID-Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews every year until you cancel. Cancel any time in your Apple ID settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva cada año hasta que lo canceles. Cancela cuando quieras en los ajustes de tu Apple ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renouvelle chaque année jusqu'à résiliation. Résiliable à tout moment dans les réglages de ton identifiant Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova ogni anno finché non disdici. Puoi disdire quando vuoi nelle impostazioni del tuo ID Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova todo ano até você cancelar. Cancele quando quiser nos ajustes do seu Apple ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продлевается каждый год, пока не отменишь. Отмена в любой момент в настройках Apple ID."
          }
        }
      }
    },
    "paywall.annualTitle": {
      "comment": "The annual plan. pricing.everythingYear.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, für ein Jahr"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything, for a year"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo, durante un año"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout, pendant un an"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto, per un anno"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo, por um ano"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся Alma — на год"
          }
        }
      }
    },
    "paywall.archiveNote": {
      "comment": "Under the archive row. cabinet.archiveNote.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle acht Systeme, einmal gekauft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All eight systems, bought once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ocho sistemas, comprados una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les huit systèmes, achetés une fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli otto sistemi, acquistati una volta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os oito sistemas, comprados uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все восемь систем — одной покупкой."
          }
        }
      }
    },
    "paywall.archiveTitle": {
      "comment": "The archive row. cabinet.wholeArchive.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ganze Archiv"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole archive"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo completo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'archive entière"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'archivio intero"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo inteiro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь архив"
          }
        }
      }
    },
    "paywall.autoRenewTerms": {
      "comment": "The auto-renewal disclosure App Review asks for, next to the payment action rather than in the terms.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung wird bei der Bestätigung über deine Apple-ID abgebucht. Das Abo verlängert sich automatisch, sofern du nicht mindestens 24 Stunden vor Ende des Zeitraums kündigst; die Verlängerung wird in den 24 Stunden davor abgebucht. Verwalten und kündigen kannst du es in deinen Apple-ID-Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment is charged to your Apple ID when you confirm. The plan renews automatically unless you cancel at least 24 hours before the period ends, and the renewal is charged within the 24 hours before it. Manage or cancel it in your Apple ID settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se carga a tu Apple ID al confirmar. El plan se renueva automáticamente salvo que lo canceles al menos 24 horas antes de que acabe el periodo, y el cobro de la renovación se hace en las 24 horas previas. Gestiónalo o cancélalo en los ajustes de tu Apple ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est débité de ton identifiant Apple à la confirmation. L'abonnement se renouvelle automatiquement sauf résiliation au moins 24 heures avant la fin de la période, et le renouvellement est débité dans les 24 heures qui la précèdent. Gère-le ou résilie-le dans les réglages de ton identifiant Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento viene addebitato sul tuo ID Apple alla conferma. L'abbonamento si rinnova automaticamente se non disdici almeno 24 ore prima della fine del periodo, e il rinnovo viene addebitato nelle 24 ore precedenti. Puoi gestirlo o disdirlo nelle impostazioni del tuo ID Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento é cobrado no seu Apple ID ao confirmar. O plano renova automaticamente a menos que você cancele pelo menos 24 horas antes do fim do período, e a renovação é cobrada nas 24 horas anteriores. Gerencie ou cancele nos ajustes do seu Apple ID."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплата списывается с твоего Apple ID при подтверждении. План продлевается автоматически, если не отменить его хотя бы за 24 часа до конца периода; продление списывается в последние 24 часа перед ним. Управление и отмена — в настройках Apple ID."
          }
        }
      }
    },
    "paywall.doorNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zahlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One payment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo pago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul paiement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo pagamento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um único pagamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один платёж."
          }
        }
      }
    },
    "paywall.doorSub": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlen oben sind deine. Das öffnet das ganze System — jedes Kapitel wird aus deinen eigenen Positionen geschrieben, nicht nach Schablone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The numbers above are yours. This opens the whole system — every chapter written from your own positions, not from a template."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números de arriba son tuyos. Esto abre todo el sistema: cada capítulo se escribe desde tus propias posiciones, no desde una plantilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nombres ci-dessus sont les tiens. Ceci ouvre tout le système — chaque chapitre est écrit à partir de tes propres positions, pas d'un modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I numeri sopra sono tuoi. Questo apre l'intero sistema: ogni capitolo è scritto dalle tue posizioni, non da un modello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os números acima são seus. Isto abre o sistema inteiro — cada capítulo é escrito a partir das suas posições, não de um modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Числа выше — твои. Это открывает всю систему: каждая глава пишется из твоих собственных позиций, а не по шаблону."
          }
        }
      }
    },
    "paywall.everythingSub": {
      "comment": "Under that title. states.lockedNote.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim ersten Öffnen aus deinen eigenen Positionen geschrieben — dein Horoskop, nie eine Vorlage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Written from your own positions the first time you open it — your chart, never a template."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrito a partir de tus propias posiciones la primera vez que lo abres — tu carta, nunca una plantilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédigé à partir de tes propres positions la première fois que tu l'ouvres — ton thème, jamais un modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scritto dalle tue posizioni la prima volta che lo apri — il tuo tema, mai un modello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrito a partir das suas próprias posições na primeira vez que você abre — o seu mapa, nunca um modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пишется из твоих собственных позиций при первом открытии — твоя карта, никогда не шаблон."
          }
        }
      }
    },
    "paywall.everythingTitle": {
      "comment": "Title of the cabinet paywall. cabinet.openWritten.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne, was dein Horoskop noch sagt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the rest of what your chart says"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir el resto de lo que dice tu carta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir le reste de ce que dit ton thème"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il resto di quello che dice il tuo tema"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir o resto do que o seu mapa diz"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой всё остальное, что говорит твоя карта"
          }
        }
      }
    },
    "paywall.freeNote": {
      "comment": "The standing promise, repeated where the money is asked for.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Berechnungen bleiben kostenlos, immer. Einen Preis hat das Geschriebene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every calculation stays free, always. What has a price is the writing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los cálculos siguen siendo gratis, siempre. Lo que tiene precio es lo escrito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les calculs restent gratuits, toujours. Ce qui a un prix, c'est le texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i calcoli restano gratis, sempre. Ad avere un prezzo è ciò che è scritto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os cálculos continuam de graça, sempre. O que tem preço é o texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый расчёт всегда бесплатен. Цену имеют только слова."
          }
        }
      }
    },
    "paywall.honestyCancel": {
      "comment": "Third line. The web app says 'cancel in two taps' from our Settings, which is false on iOS.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kündigen in den Apple-ID-Einstellungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cancel in your Apple ID settings"
          }
        },
        "es": {
