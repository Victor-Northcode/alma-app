    "paywall.verifyLater": {
      "comment": "503 from our own server after Apple took the money. The store's notification grants independently.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat die Zahlung eingezogen. Wir konnten sie gerade nicht bestätigen — sie öffnet sich gleich von selbst, und nichts geht verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple has taken the payment. We could not confirm it this second — it will open by itself shortly, and nothing is lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ya cobró el pago. No hemos podido confirmarlo en este momento — se abrirá solo en un momento y no se pierde nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple a prélevé le paiement. Nous n'avons pas pu le confirmer à l'instant — cela s'ouvrira tout seul sous peu, et rien n'est perdu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
