    "paywall.manageNote": {
      "comment": "Why the cancel button is a link to Apple rather than a button of ours.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der App gekaufte Abos kündigst du in den Apple-ID-Einstellungen, nicht hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plans bought in the app are cancelled in your Apple ID settings, not here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los planes comprados en la app se cancelan en los ajustes de tu Apple ID, no aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements achetés dans l'app se résilient dans les réglages de ton identifiant Apple, pas ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli abbonamenti acquistati nell'app si disdicono nelle impostazioni del tuo ID Apple, non qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Planos comprados no app são cancelados nos ajustes do seu Apple ID, não aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Планы, купленные в приложении, отменяются в настройках Apple ID, не здесь."
          }
        }
      }
    },
    "paywall.monthlyNote": {
      "comment": "What the monthly plan actually grants. Not everything — the living layer.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transite, Solarhoroskop und Partnerschaft, solange sie ziehen, dazu 40 Fragen im Monat. Verlängert sich, bis du kündigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transits, the solar return and compatibility while they move, plus 40 questions a month. Renews until you cancel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tránsitos, revolución solar y compatibilidad mientras se mueven, más 40 preguntas al mes. Se renueva hasta que lo canceles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transits, révolution solaire et compatibilité au fil de leur course, plus 40 questions par mois. Se renouvelle jusqu'à résiliation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Transiti, rivoluzione solare e affinità mentre si muovono, più 40 domande al mese. Si rinnova finché non disdici."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trânsitos, revolução solar e compatibilidade conforme se movem, mais 40 perguntas por mês. Renova até você cancelar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзиты, соляр и совместимость, пока они движутся, плюс 40 вопросов в месяц. Продлевается, пока не отменишь."
          }
        }
      }
    },
    "paywall.monthlyTitle": {
