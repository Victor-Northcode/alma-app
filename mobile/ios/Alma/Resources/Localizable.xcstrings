    "push.daily.conjunction": {
      "comment": "Body. %1$@ transiting body, %2$@ natal point, %3$@ time.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ und %2$@ — exakte Konjunktion um %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ meets your %2$@ at %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se une a tu %2$@ a las %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ et %2$@ — conjonction exacte à %3$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ e %2$@ — congiunzione esatta alle %3$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ e %2$@ — conjunção exata às %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ и %2$@ — точное соединение в %3$@."
          }
        }
      }
    },
    "push.daily.entering.conjunction": {
      "comment": "Orb entry. %1$@ transiting body, %2$@ natal point.",
      "extractionState": "manual",
      "localizations": {
        "de": {
