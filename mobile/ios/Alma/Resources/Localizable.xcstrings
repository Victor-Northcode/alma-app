          }
        }
      }
    },
    "state.somethingWrong": {
      "comment": "The generic failure. Says what is true: nothing paid for is lost.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen. Verloren gegangen ist nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Nothing was lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo ha salido mal. No se ha perdido nada."
          }
