          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is coming to your %2$@. In orb from today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se acerca a tu %2$@. En orbe desde hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ et %2$@ — conjonction, dans l'orbe dès aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ e %2$@ — congiunzione, in orbe da oggi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ e %2$@ — conjunção, em orbe a partir de hoje."
