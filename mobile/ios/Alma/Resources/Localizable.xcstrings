          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так. Ничего не потерялось."
          }
        }
      }
    },
    "state.unavailable": {
      "comment": "Our side is down — the AI, billing, or the place index.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf unserer Seite funktioniert etwas nicht. Es liegt nicht an dir und nicht an deinem Horoskop."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something on our side is not working. It is not you, and it is not your chart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo de nuestro lado no funciona. No eres tú, y no es tu carta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose ne fonctionne pas de notre côté. Ce n'est pas toi, et ce n'est pas ton thème."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa dalla nostra parte non funziona. Non sei tu, e non è il tuo tema."
