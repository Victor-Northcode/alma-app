    "state.accountDeleted": {
      "comment": "The account behind the stored token no longer exists.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto wurde gelöscht. Nichts davon wird aufbewahrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has been deleted. Nothing of it is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta se ha eliminado. No se conserva nada de ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte a été supprimé. Il n'en reste rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account è stato eliminato. Non ne resta nulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta foi excluída. Nada dela foi guardado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот аккаунт удалён. От него ничего не осталось."
          }
        }
      }
    },
    "state.loading": {
      "comment": "Waiting for a calculation. Not \"Loading\" — the wait has a reason.",
