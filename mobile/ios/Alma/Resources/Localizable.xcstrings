    "state.needsBirthTime": {
      "comment": "Solar return and astrocartography need the minute of birth.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür braucht es deine Geburtszeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This one needs your birth time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este necesita tu hora de nacimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui-ci demande ton heure de naissance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo richiede la tua ora di nascita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este precisa da sua hora de nascimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого нужно время рождения."
          }
        }
      }
    },
    "state.nothingToSay": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das konnte ich in deinem Horoskop nicht lesen, und ich erfinde es nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't read this from your chart, and I won't invent it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pude leer esto en tu carta, y no lo voy a inventar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n'ai pas pu lire ça dans ton thème, et je ne vais pas l'inventer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ho potuto leggerlo nel tuo tema, e non lo inventerò."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consegui ler isso no seu mapa, e não vou inventar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я не смогла прочитать это в твоей карте — и не стану выдумывать."
          }
        }
      }
    },
    "state.offline": {
      "comment": "No connection to the backend. The web app's version mentions sample data; this app shows none, so the sentence is different.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma antwortet gerade nicht. Hier wird nichts geraten, also gibt es nichts zu zeigen, bis sie es tut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma is not answering right now. Nothing here is guessed, so there is nothing to show until she does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma no responde ahora mismo. Aquí no se adivina nada, así que no hay nada que mostrar hasta que responda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma ne répond pas pour le moment. Ici rien n'est deviné, donc il n'y a rien à montrer tant qu'elle ne répond pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma non risponde in questo momento. Qui non si indovina niente, quindi non c'è nulla da mostrare finché non risponde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Alma não está respondendo agora. Aqui nada é adivinhado, então não há nada para mostrar até ela responder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma сейчас не отвечает. Здесь ничего не выдумывают — пока она молчит, показать нечего."
          }
        }
      }
    },
    "state.retry": {
      "comment": "The one way out of a retryable failure.",
      "extractionState": "manual",
