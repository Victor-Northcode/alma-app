    "journey.handoffSub": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Regeln, die das hier tragen — mehr Einführung gibt es nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three rules that make this work — the only onboarding we'll ever give you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres reglas que hacen que esto funcione — la única guía que te vamos a dar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois règles qui font tenir tout ça — la seule prise en main qu'on te donnera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre regole che fanno funzionare tutto — l'unica introduzione che ti daremo."
