    "journey.nameSub": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Name ist kein Konto. Noch wird nichts gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name isn't an account. Nothing is saved yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre no es una cuenta. Todavía no se guarda nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un prénom n'est pas un compte. Rien n'est encore enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nome non è un account. Non stiamo ancora salvando niente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nome não é uma conta. Ainda não estamos salvando nada."
