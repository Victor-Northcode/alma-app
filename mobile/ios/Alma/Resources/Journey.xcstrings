    "journey.ceremony.8.line": {
      "comment": "Ceremony beat 8, Alma's line.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neun Achsen. Wo drei Traditionen übereinstimmen, geht das in deinen Kern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nine axes. Where three traditions agree, that goes to your core."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nueve ejes. Donde tres tradiciones coinciden, eso va a tu núcleo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuf axes. Là où trois traditions s'accordent, ça part dans ton noyau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nove assi. Dove tre tradizioni concordano, quello va nel tuo nucleo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nove eixos. Onde três tradições concordam, aquilo vai para o seu núcleo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Девять осей. Где три традиции согласны — это идёт в твоё ядро."
          }
        }
      }
    },
