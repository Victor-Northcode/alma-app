    "journey.ceremony.2.line": {
      "comment": "Ceremony beat 2, Alma's line.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Numerologie berechnet aus deinem Geburtsdatum deine Lebenswegzahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Numerology turns your birth date into your life-path number."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La numerología convierte tu fecha de nacimiento en el número de tu camino de vida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La numérologie transforme ta date de naissance en ton nombre de chemin de vie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La numerologia trasforma la tua data di nascita nel numero del percorso di vita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A numerologia transforma sua data de nascimento no número do seu caminho de vida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число жизненного пути рассчитывается по дате рождения."
          }
        }
      }
    },
    "journey.ceremony.3.label": {
      "comment": "Ceremony beat 3, overline.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System 3 von 8 wird gelesen · Tarot-Geburtskarte"
          }
        },
        "en": {
