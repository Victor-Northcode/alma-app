            "state": "translated",
            "value": "Dove è cominciato tutto?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde você nasceu?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где всё началось?"
          }
        }
      }
    },
    "journey.rule.1": {
      "comment": "House rule 1.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kapitel nach dem anderen. Sechzehn auf einmal sind Lärm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One chapter at a time. Sixteen at once is noise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un capítulo cada vez. Dieciséis de golpe es ruido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chapitre à la fois. Seize d'un coup, c'est du bruit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un capitolo alla volta. Sedici insieme sono rumore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um capítulo por vez. Dezesseis de uma vez é barulho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По одной главе за раз. Шестнадцать сразу — это шум."
          }
        }
      }
    },
    "journey.rule.2": {
      "comment": "House rule 2.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn zwei Systeme sich widersprechen, wähl keinen Sieger. Genau da liegt das Material."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When two systems disagree, don't pick a winner. That's the material."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando dos sistemas no coinciden, no elijas ganador. Ahí está el material."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand deux systèmes se contredisent, ne choisis pas de gagnant. C'est là qu'est la matière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando due sistemi litigano, non scegliere un vincitore. È lì il materiale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando dois sistemas discordam, não escolha um vencedor. O material está aí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда две системы расходятся, не выбирай победителя. Это и есть материал."
          }
        }
      }
    },
    "journey.rule.3": {
      "comment": "House rule 3.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag mich mit deinen eigenen Worten. Drei Fragen sind gratis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask me in your own words. Three questions are free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntame con tus palabras. Tres preguntas son gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande-moi avec tes mots. Trois questions sont gratuites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedimi con parole tue. Tre domande sono gratis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Me pergunte com suas palavras. Três perguntas são de graça."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивай меня своими словами. Три вопроса бесплатно."
          }
        }
      }
    },
