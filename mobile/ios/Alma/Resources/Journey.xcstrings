    "journey.ceremony.2.line": {
      "comment": "Ceremony beat 2, Alma's line.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Lebensweg wird zu einer Zahl, die Beweise lieber mag als Glauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your life path reduces to a number that prefers proof over belief."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sendero de vida se reduce a un número que prefiere pruebas a creencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton chemin de vie se réduit à un nombre qui préfère les preuves aux croyances."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo sentiero di vita si riduce a un numero che preferisce le prove alla fede."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu caminho de vida se reduz a um número que prefere prova a crença."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой жизненный путь сводится к числу, которое предпочитает доказательства вере."
          }
        }
      }
    },
    "journey.ceremony.3.label": {
