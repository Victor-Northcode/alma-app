    "journey.offerFine": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zahlung. Dauerhaft deins. Zum Kaufen brauchst du kein Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One payment. Yours permanently. No account needed to buy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo pago. Tuyo para siempre. No hace falta cuenta para comprar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul paiement. À toi définitivement. Aucun compte requis pour acheter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pagamento solo. Tuo per sempre. Per comprare non serve un account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pagamento só. Seu para sempre. Não precisa de conta para comprar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один платёж. Твоё навсегда. Для покупки не нужен аккаунт."
          }
        }
      }
    },
    "journey.offerSkip": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt nicht — bring mich rein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now — take me in"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no — llévame dentro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas maintenant — fais-moi entrer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ora — portami dentro"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora não — me leva para dentro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сейчас — впусти меня"
          }
        }
      }
    },
    "journey.offerSub": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlen oben gehören dir und bleiben kostenlos. Das hier öffnet das ganze System — jedes Kapitel der Deutung, aus deinen Positionen geschrieben, keine Vorlage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The numbers above are yours and stay free. This opens the whole system — every chapter of the reading, written from your positions, not a template."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números de arriba son tuyos y siguen siendo gratis. Esto abre el sistema entero — cada capítulo de la lectura, escrito desde tus posiciones, no una plantilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nombres ci-dessus sont à toi et restent gratuits. Ceci ouvre le système entier — chaque chapitre de la lecture, écrit à partir de tes positions, pas un modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I numeri qui sopra sono tuoi e restano gratis. Questo apre l'intero sistema — ogni capitolo della lettura, scritto dalle tue posizioni, non un modello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os números acima são seus e continuam de graça. Isto abre o sistema inteiro — cada capítulo da leitura, escrito a partir das suas posições, não um modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Числа выше — твои, и они остаются бесплатными. Это открывает всю систему — каждую главу чтения, написанную из твоих позиций, а не по шаблону."
          }
        }
      }
    },
