    "journey.placeSub": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stadt genügt. Die historische Zeitzone lösen wir selbst auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "City is enough. We resolve the historical time zone ourselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la ciudad basta. El huso horario histórico lo resolvemos nosotros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ville suffit. Le fuseau horaire historique, on le résout nous-mêmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta la città. Il fuso orario storico lo risolviamo noi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cidade basta. O fuso horário histórico a gente resolve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Города достаточно. Исторический часовой пояс мы находим сами."
          }
        }
      }
    },
    "journey.placeTitle": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo bist du geboren?"
          }
        },
        "en": {
