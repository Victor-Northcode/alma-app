    "journey.ceremony.1.label": {
      "comment": "Ceremony beat 1, overline.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System 1 von 8 wird gelesen · Geburtshoroskop"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "reading system 1 of 8 · natal chart"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "leyendo el sistema 1 de 8 · carta natal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "lecture du système 1 sur 8 · thème natal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "leggo il sistema 1 di 8 · tema natale"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "lendo o sistema 1 de 8 · mapa natal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "читаю систему 1 из 8 · натальная карта"
          }
        }
      }
    },
    "journey.ceremony.1.line": {
      "comment": "Ceremony beat 1, Alma's line.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zehn Planeten, zwölf Häuser — dein Horoskop entsteht aus echten Ephemeriden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your birth chart maps the planets and key points across twelve houses using astronomical ephemeris data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diez planetas, doce casas — tu carta se traza con efemérides reales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dix planètes, douze maisons — ton thème est tracé à partir d'éphémérides réelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo tema colloca pianeti e punti principali nelle dodici case usando dati astronomici delle effemeridi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dez planetas, doze casas — seu mapa é traçado com efemérides de verdade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Десять планет, двенадцать домов — твоя карта строится по настоящей эфемериде."
          }
        }
      }
    },
    "journey.ceremony.2.label": {
      "comment": "Ceremony beat 2, overline.",
      "extractionState": "manual",
      "localizations": {
