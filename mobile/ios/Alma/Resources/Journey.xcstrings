    "journey.rule.1": {
      "comment": "House rule 1.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kapitel nach dem anderen. Sechzehn auf einmal sind Lärm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with one chapter. Explore the rest whenever you’re ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un capítulo cada vez. Dieciséis de golpe es ruido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chapitre à la fois. Seize d'un coup, c'est du bruit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia da un capitolo. Esplora gli altri quando vuoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um capítulo por vez. Dezesseis de uma vez é barulho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывай главы по одной — так в них проще разобраться."
          }
        }
      }
    },
    "journey.rule.2": {
      "comment": "House rule 2.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn zwei Systeme sich widersprechen, wähl keinen Sieger. Genau da liegt das Material."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When two systems differ, notice the tension: they may describe different sides of you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando dos sistemas no coinciden, no elijas uno. Ahí está lo que vale la pena explorar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand deux systèmes se contredisent, ne choisis pas de gagnant. C'est justement là que ça devient intéressant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando due sistemi differiscono, osserva la tensione: possono descrivere lati diversi di te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando dois sistemas discordam, não escolha um vencedor. É aí que vale a pena prestar atenção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнивай интерпретации: расхождения помогают увидеть тему с разных сторон."
          }
        }
      }
    },
    "journey.rule.3": {
      "comment": "House rule 3.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag mit deinen eigenen Worten. Die erste Frage ist kostenlos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask in your own words. Your first question is free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta con tus palabras. La primera pregunta es gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose tes questions avec tes propres mots. La première est offerte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi con parole tue. La prima domanda è gratis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte com suas palavras. A primeira pergunta é grátis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивай своими словами. Первый вопрос — бесплатно."
          }
        }
      }
    },
