{
  "sourceLanguage": "en",
  "strings": {
    "journey.aboutSub": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit Alma richtig mit dir sprechen kann. Du kannst es überspringen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So Alma can speak to you properly. You can skip this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que Alma te hable como corresponde. Puedes saltarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour qu'Alma te parle comme il faut. Tu peux passer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché Alma possa parlarti come si deve. Puoi saltare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a Alma falar com você do jeito certo. Você pode pular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы Alma говорила с тобой правильно. Можно пропустить."
          }
        }
      }
    },
