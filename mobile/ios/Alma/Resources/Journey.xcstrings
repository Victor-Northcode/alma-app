    "journey.offerSub": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlen oben gehören dir und bleiben kostenlos. Das hier öffnet das ganze System — jedes Kapitel der Deutung, aus deinen Positionen geschrieben, keine Vorlage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The insights above stay free. This unlocks the full personalised reading for this system."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números de arriba son tuyos y siguen siendo gratis. Esto abre el sistema entero — cada capítulo de la lectura, escrito desde tus posiciones, no una plantilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nombres ci-dessus sont à toi et restent gratuits. Ceci ouvre le système entier — chaque chapitre de la lecture, écrit à partir de tes positions, pas un modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le informazioni qui sopra restano gratuite. Questo sblocca la lettura completa e personalizzata del sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os números acima são seus e continuam de graça. Isto abre o sistema inteiro — cada capítulo da leitura, escrito a partir das suas posições, não um modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Числа выше — твои, и они остаются бесплатными. Это открывает всю систему — каждую главу чтения, написанную из твоих позиций, а не по шаблону."
          }
        }
      }
    },
