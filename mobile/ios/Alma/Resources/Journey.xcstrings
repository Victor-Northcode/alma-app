    "journey.timeSub": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhrzeit gibt Häuser, das Solar und deine Karte. Ohne sie bleiben die zu — erfinden werden wir sie nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time gives houses, the solar return and your map. Without it those stay locked — we won't invent them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora da las casas, la revolución solar y tu mapa. Sin ella quedan cerrados — no los vamos a inventar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'heure donne les maisons, la révolution solaire et ta carte. Sans elle, elles restent fermées — on ne les inventera pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ora dà le case, la rivoluzione solare e la tua mappa. Senza restano chiuse — non le inventiamo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A hora dá as casas, a revolução solar e o seu mapa. Sem ela, ficam fechados — e a gente não inventa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время даёт дома, соляр и твою карту мира. Без него они остаются закрытыми — мы не станем их выдумывать."
          }
        }
      }
    },
    "journey.timeTitle": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um wie viel Uhr bist du geboren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What time were you born?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A qué hora naciste?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quelle heure tout a-t-il commencé ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A che ora è cominciato tutto?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que horas você nasceu?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во сколько всё началось?"
          }
        }
      }
    }
  },
  "version": "1.0"
}