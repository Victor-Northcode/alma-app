    "journey.freeNote": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese beiden Systeme kosten nie etwas. Sie gehören dir, ob du weiterliest oder nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These two systems never cost anything. They are yours whether you read further or not."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos dos sistemas nunca cuestan nada. Son tuyos, sigas leyendo o no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces deux systèmes ne coûtent jamais rien. Ils sont à toi, que tu lises la suite ou non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi due sistemi non costano mai nulla. Sono tuoi, che tu legga oltre o no."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses dois sistemas nunca custam nada. São seus, você lendo mais ou não."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти две системы не стоят ничего и никогда. Они твои, читаешь ты дальше или нет."
          }
        }
      }
    },
