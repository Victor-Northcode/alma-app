    "journey.ceremony.8.line": {
      "comment": "Ceremony beat 8, Alma's line.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neun Achsen. Wo drei Systeme übereinstimmen, zeigt sich, was dich im Kern prägt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nine life areas compared across your birth chart, numerology and Tarot Birth Card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nueve ejes. Cuando tres sistemas coinciden, aparece un patrón central."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuf axes. Là où trois systèmes s’accordent, cela révèle ce qui est au cœur de ta personnalité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nove aree della vita confrontate tra tema natale, numerologia e Carta dei tarocchi di nascita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nove eixos. Quando três sistemas concordam, aparece um padrão central."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Девять осей. Где три традиции согласны — это идёт в твою основу."
          }
        }
      }
    },
