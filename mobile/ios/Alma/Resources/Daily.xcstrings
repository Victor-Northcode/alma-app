    "daily.status.provisional": {
      "comment": "iOS provisional authorization, described as it actually behaves.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie kommen leise an. Almas Mitteilungen gehen direkt in die Mitteilungszentrale — ohne Banner, ohne Ton — bis du es anders entscheidest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriving quietly. Alma's notifications go straight to Notification Center — no banner, no sound — until you decide otherwise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegan en silencio. Las notificaciones de Alma van directas al Centro de notificaciones —sin banner ni sonido— hasta que decidas otra cosa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles arrivent discrètement. Les notifications d'Alma vont directement au Centre de notifications — sans bannière ni son — jusqu'à ce que tu en décides autrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrivano in silenzio. Le notifiche di Alma vanno dritte al Centro Notifiche — senza banner né suono — finché non decidi diversamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegam em silêncio. As notificações da Alma vão direto para a Central de Notificações — sem banner nem som — até você decidir o contrário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приходит тихо. Уведомления Alma идут прямо в Центр уведомлений — без баннера и звука, пока ты не решишь иначе."
          }
        }
      }
    },
