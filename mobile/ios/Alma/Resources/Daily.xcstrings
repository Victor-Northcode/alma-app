    "daily.status.notDelivering": {
      "comment": "Truthful when this device has no accepted push registration.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird noch nichts gesendet. Dieses Telefon ist nicht für Mitteilungen registriert, also lebt das Tägliche hier, unter Heute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is being sent yet. This phone is not registered for notifications, so the daily lives here, on Today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se envía nada. Este teléfono no está registrado para notificaciones, así que lo diario vive aquí, en Hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est encore envoyé. Ce téléphone n'est pas enregistré pour les notifications, le quotidien vit donc ici, dans Aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene ancora inviato nulla. Questo telefono non è registrato per le notifiche, quindi il quotidiano vive qui, in Oggi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada está sendo enviado ainda. Este telefone não está registrado para notificações, então o diário vive aqui, em Hoje."
          }
        },
