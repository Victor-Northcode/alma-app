    "daily.setting.occasionally.detail": {
      "comment": "Under position 2. The measured cadence, stated plainly.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa einmal pro Woche, wenn in deinem Horoskop wirklich etwas exakt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About once a week, when something in your chart is actually exact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproximadamente una vez por semana, cuando algo en tu carta es exacto de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ une fois par semaine, quand quelque chose dans ton thème devient vraiment exact."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa una volta a settimana, quando qualcosa nel tuo tema diventa davvero esatto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de uma vez por semana, quando algo no seu mapa fica realmente exato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерно раз в неделю, когда что-то в твоей карте действительно становится точным."
          }
        }
      }
    },
