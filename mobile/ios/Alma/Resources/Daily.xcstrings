{
  "sourceLanguage": "en",
  "strings": {
    "daily.action.quieter": {
      "comment": "Action button on every notification. Steps down a position.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger davon"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fewer of these"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos de estas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins souvent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno di queste"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos disto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пореже"
          }
        }
      }
    },
    "daily.action.turnOff": {
      "comment": "Action button on every notification. One tap to Off.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese abschalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn these off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar esto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva queste"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligar isto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключить их"
          }
        }
      }
    },
    "daily.action.turnedOff": {
      "comment": "Confirmation banner after the notification action ran.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschaltet. Heute ist trotzdem da, wann immer du es öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned off. Today is still here whenever you open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado. Hoy sigue aquí siempre que lo abras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé. Aujourd'hui reste là chaque fois que tu l'ouvres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato. Oggi resta qui ogni volta che lo apri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado. Hoje continua aqui sempre que você abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено. «Сегодня» всегда на месте, когда ты открываешь приложение."
          }
        }
      }
    },
    "daily.ask.body": {
      "comment": "What will arrive and how often, before any system dialog.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mitteilung, zur Stunde deiner Wahl, an den Tagen, an denen etwas in deiner Karte exakt ist. Etwa einmal die Woche. Nie nachts, und aus der Mitteilung selbst abschaltbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One notification, at the hour you choose, on the days something in your chart is exact. About once a week. Never at night, and it can be turned off from the notification itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notificación, a la hora que elijas, los días en que algo en tu carta es exacto. Más o menos una vez por semana. Nunca de noche, y se puede desactivar desde la propia notificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification, à l'heure que tu choisis, les jours où quelque chose est exact dans ta carte. Environ une fois par semaine. Jamais la nuit, et désactivable depuis la notification elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notifica, all'ora che scegli, nei giorni in cui qualcosa nella tua carta è esatto. Circa una volta a settimana. Mai di notte, e si disattiva dalla notifica stessa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma notificação, na hora que você escolher, nos dias em que algo no seu mapa fica exato. Cerca de uma vez por semana. Nunca à noite, e dá para desligar pela própria notificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно уведомление, в выбранный тобой час, в те дни, когда что-то в твоей карте точно. Примерно раз в неделю. Никогда ночью, и выключить можно прямо из самого уведомления."
          }
        }
      }
    },
    "daily.ask.no": {
      "comment": "Declines, repeatably. Our question costs nothing to ask twice.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt nicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas maintenant"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ora"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora não"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сейчас"
          }
        }
      }
    },
    "daily.ask.title": {
      "comment": "The invitation on Today. THE-DAILY §5.2's second entrance.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag mir Bescheid an dem Morgen, an dem es passiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me the morning it happens"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avísame la mañana en que ocurra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préviens-moi le matin où cela arrive"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimmelo la mattina in cui accade"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Me avise na manhã em que acontecer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажи мне в то утро, когда это случится"
          }
        }
      }
    },
    "daily.ask.yes": {
      "comment": "Accepts the invitation. The platform prompt comes after this.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, sag mir Bescheid"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, tell me"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, avísame"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, préviens-moi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sì, dimmelo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sim, me avise"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да, говори"
          }
        }
      }
    },
