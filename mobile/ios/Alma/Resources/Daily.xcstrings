    "daily.status.denied": {
      "comment": "Shown once, never nagged. §5.5(3).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen für Alma sind aus. Du kannst sie in den Einstellungen deines Telefons einschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off for Alma. You can turn them on in your phone's settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de Alma están desactivadas. Puedes activarlas en los ajustes del teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
