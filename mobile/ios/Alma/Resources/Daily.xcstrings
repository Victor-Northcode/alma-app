    "daily.empty.body": {
      "comment": "Under the empty state, pointing at what is still live.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was noch im Orbis steht, findest du unten. Heute wird nichts exakt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is still in orb is below. Nothing perfects today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que sigue en orbe está abajo. Hoy nada se hace exacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est encore dans l'orbe est ci-dessous. Rien ne devient exact aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che è ancora in orbe è qui sotto. Oggi niente diventa esatto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que ainda está em orbe está abaixo. Hoje nada se torna exato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что ещё в орбисе — ниже. Сегодня ничто не достигает точной отметки."
          }
        }
      }
    },
    "daily.empty.title": {
      "comment": "The honest empty state. A day with nothing exact is a real answer.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute ist nichts exakt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is exact today"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy nada es exacto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est exact aujourd'hui"
