    "daily.setting.off.detail": {
      "comment": "Under position 1. Makes Off a safe choice rather than a loss.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Mitteilungen. Heute ist trotzdem da, wann immer du es öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No notifications. Today is still here whenever you open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin notificaciones. Hoy sigue aquí siempre que lo abras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune notification. Aujourd'hui reste là chaque fois que tu l'ouvres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna notifica. Oggi resta qui ogni volta che lo apri."
          }
