    "daily.setting.onlyMatters.detail": {
      "comment": "Under position 3.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar Mal im Jahr. Nur die langsamen — die Transite, die Monate dauern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few times a year. The slow ones only — the transits that last months."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas pocas veces al año. Solo los lentos: los tránsitos que duran meses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques fois par an. Seulement les lents — les transits qui durent des mois."
