            "state": "translated",
            "value": "%1$@ ora e %3$@ nel tuo tema: %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ em %2$@ com %3$@ no seu mapa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ сейчас и %3$@ в твоей карте: %2$@"
          }
        }
      }
    },
    "daily.empty.body": {
      "comment": "Under the empty state, pointing at what is still live.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktiven Transite stehen unten. Heute erreicht keiner seinen exakten Punkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active transits are shown below. None reaches its exact point today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tránsitos activos aparecen abajo. Ninguno alcanza su punto exacto hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transits actifs sont affichés ci-dessous. Aucun n’atteint son point exact aujourd’hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I transiti attivi sono qui sotto. Nessuno raggiunge il punto esatto oggi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os trânsitos ativos aparecem abaixo. Nenhum chega ao ponto exato hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активные транзиты показаны ниже. Сегодня ни один не достигает точного положения."
          }
        }
      }
    },
    "daily.empty.title": {
      "comment": "The honest empty state. A day with nothing exact is a real answer.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute ist nichts exakt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No transit is exact today"
          }
        },
        "es": {
