    "cab.skyEvent.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Tage wie diesen gibt es die Morgenbenachrichtigung — sie kommt um 08:00, wenn etwas in deinem Horoskop exakt ist. Teil des Plans."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days like this are what the morning notification is for — it arrives at 08:00 when something in your chart is exact. Part of the plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para días así existe la notificación de la mañana — llega a las 08:00 cuando algo en tu carta es exacto. Parte del plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est pour des jours comme celui-ci qu'existe la notification du matin — elle arrive à 08h00 quand quelque chose est exact dans ton thème. Ça fait partie de l'abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per giorni così esiste la notifica del mattino — arriva alle 08:00 quando qualcosa nel tuo tema è esatto. Parte del piano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para dias assim existe a notificação da manhã — ela chega às 08:00 quando algo no seu mapa está exato. Parte do plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для таких дней и существует утреннее уведомление — оно приходит в 08:00, когда что-то в твоей карте точно. Это часть подписки."
          }
        }
      }
    },
    "cab.spheresLabel": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
