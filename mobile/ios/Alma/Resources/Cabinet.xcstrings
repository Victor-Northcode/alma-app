    "cab.horoscopeLocked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein tägliches Horoskop wird jeden Morgen aus deinem Geburtshoroskop erstellt und ist im Abo enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The horoscope is written from your own chart every morning, and it comes with the plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El horóscopo se escribe cada mañana desde tu propia carta y viene con el plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton horoscope du jour est rédigé chaque matin à partir de ton thème natal et fait partie de l'abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'oroscopo si scrive ogni mattina dalla tua carta e fa parte del piano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O horóscopo é escrito toda manhã a partir do seu mapa e vem com o plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гороскоп пишется каждое утро из твоей собственной карты и входит в подписку."
          }
        }
      }
    },
