    "cab.plan.cancelFailed": {
      "comment": "Settings — plan, export, deletion.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten den Zahlungsanbieter nicht erreichen, es wurde also nichts geändert. Versuch es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not reach the payment processor, so nothing has changed. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos podido contactar con la pasarela de pago, así que no se ha cambiado nada. Inténtalo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu joindre le prestataire de paiement, rien n’a donc été modifié. Réessaie dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a contattare il sistema di pagamento, quindi non è cambiato nulla. Riprova fra un momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não conseguimos falar com o meio de pagamento, então nada foi alterado. Tente de novo daqui a pouco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не получилось связаться с платёжной системой, ничего не изменилось. Попробуй ещё раз через минуту."
          }
        }
      }
    },
