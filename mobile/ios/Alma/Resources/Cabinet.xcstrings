    "cab.languageNote": {
      "comment": "Which of the two languages this picker sets.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich lese und schreibe in der Sprache deines Telefons. Änderst du sie dort, ändere ich mich mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I read and write in the language of your phone. Change it there and I change with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leo y escribo en el idioma de tu teléfono. Cámbialo allí y cambio contigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lis et j'écris dans la langue de ton téléphone. Change-la là-bas, et je change avec elle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggo e scrivo nella lingua del tuo telefono. Cambiala lì e cambio anch'io."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu leio e escrevo no idioma do seu telefone. Mude o idioma lá e eu mudo junto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я читаю и пишу на языке твоего телефона. Поменяешь его — поменяюсь и я."
          }
        }
      }
    },
