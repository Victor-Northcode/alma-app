    "cab.chapterEnd.door": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rest dieses Systems ist genauso geschrieben — aus deinen Positionen, für immer deins."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rest of this system is written the same way — from your positions, yours to keep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resto de este sistema está escrito igual — desde tus posiciones, tuyo para siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le reste de ce système est écrit de la même façon — à partir de tes positions, et reste à toi pour toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il resto di questo sistema è scritto allo stesso modo — dalle tue posizioni, tuo per sempre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resto deste sistema é escrito do mesmo jeito — das suas posições, seu para sempre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остальное в этой системе написано так же — из твоих позиций, и остаётся твоим."
          }
        }
      }
    },
    "cab.chapterEnd.plan": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Kapitel wird einmal geschrieben. Transite, das Jahr und die Partnerschaft werden neu geschrieben, während der Himmel sich bewegt — das ist der Plan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chapter is written once. Transits, the year and compatibility are rewritten as the sky moves — that is the plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este capítulo se escribe una vez. Los tránsitos, el año y la compatibilidad se reescriben con el cielo — eso es el plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce chapitre s'écrit une fois. Les transits, l'année et la compatibilité se réécrivent avec le ciel — c'est ça, l'abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo capitolo si scrive una volta. Transiti, l'anno e l'affinità si riscrivono col cielo che si muove — questo è il piano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este capítulo é escrito uma vez. Trânsitos, o ano e a compatibilidade são reescritos conforme o céu se move — esse é o plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта глава создаётся один раз. Транзиты, соляр и совместимость обновляются, пока действует подписка."
          }
        }
      }
    },
