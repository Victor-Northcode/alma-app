    "cab.plans.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abo hält Transite, Solarhoroskop und Kompatibilität aktuell, schickt die Morgenmitteilung und enthält 30 Fragen im Monat. Alle acht Systeme öffnet das Jahresabo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan keeps transits, Solar Return and compatibility live, sends the morning update, and includes 30 questions a month. The yearly plan opens all eight systems."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción mantiene al día tránsitos, revolución solar y compatibilidad, envía el aviso matinal e incluye 30 preguntas al mes. El plan anual abre los ocho sistemas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abonnement garde à jour les transits, la révolution solaire et la compatibilité, envoie la notification du matin et inclut 30 questions par mois. L'abonnement annuel ouvre les huit systèmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano tiene aggiornati transiti, Rivoluzione solare e compatibilità, invia l'aggiornamento del mattino e include 30 domande al mese. Il piano annuale apre tutti e otto i sistemi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura mantém atualizados trânsitos, revolução solar e compatibilidade, envia o aviso da manhã e inclui 30 perguntas por mês. O plano anual abre os oito sistemas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка держит живыми транзиты, соляр и совместимость, присылает утреннее уведомление и включает 25 вопросов в месяц. Все восемь систем открывает годовой план."
          }
        }
      }
    },
