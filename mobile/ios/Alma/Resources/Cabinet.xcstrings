    "cab.settings.lettersNote": {
      "comment": "Settings.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma schickt drei: deinen Anmeldelink, einen Beleg für alles, was du kaufst, und eine Warnung drei Tage vor jeder Verlängerung. Alle drei betreffen etwas, das du getan hast. Es gibt keinen Newsletter und nichts abzubestellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma sends three: your sign-in link, a receipt for anything you buy, and a warning three days before a plan renews. All three are about something you did. There is no newsletter and nothing to unsubscribe from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma envía tres: tu enlace de acceso, un recibo por lo que compres y un aviso tres días antes de que se renueve un plan. Las tres son por algo que hiciste. No hay boletín ni nada de lo que darse de baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma en envoie trois : ton lien de connexion, un reçu pour tes achats et un avertissement trois jours avant le renouvellement d'un abonnement. Ces messages concernent uniquement tes actions. Il n'y a pas de newsletter, donc aucune désinscription à effectuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma ne manda tre: il tuo link di accesso, una ricevuta per quello che compri e un avviso tre giorni prima che un piano si rinnovi. Tutte e tre riguardano qualcosa che hai fatto. Non c'è nessuna newsletter e non c'è nulla da disdire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Alma manda três: seu link de acesso, um recibo do que você comprar e um aviso três dias antes de um plano renovar. As três são sobre algo que você fez. Não há newsletter nem nada para cancelar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma отправляет три письма: ссылку для входа, чек за покупку и предупреждение за три дня до продления плана. Все три — только про твои собственные действия. Рассылки нет, отписываться не от чего."
          }
        }
      }
    },
    "cab.settings.lettersNoteStore": {
      "comment": "Which letters Alma sends, on a build where Apple is the merchant.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma sendet einen: deinen Anmeldelink. Apple sendet die Rechnung für alles, was du in der App kaufst, und die Warnung vor einer Verlängerung — denn Apple zieht die Zahlung ein. Es gibt keinen Newsletter und nichts abzubestellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma sends one: your sign-in link. Apple sends the receipt for anything you buy in the app and the warning before a plan renews, because Apple takes the payment. There is no newsletter and nothing to unsubscribe from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma envía uno: tu enlace de acceso. Apple envía el recibo de todo lo que compres en la app y el aviso antes de que se renueve un plan, porque Apple cobra el pago. No hay boletín ni nada de lo que darse de baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma envoie une chose : ton lien de connexion. Apple envoie le reçu de tout ce que tu achètes dans l'app et l'avertissement avant le renouvellement d'un abonnement, car c'est Apple qui encaisse. Il n'y a pas de newsletter et rien à résilier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma invia una cosa: il tuo link di accesso. Apple invia la ricevuta di tutto ciò che compri nell'app e l'avviso prima del rinnovo di un piano, perché è Apple a incassare. Non c'è newsletter e non c'è nulla da disdire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma envia um e-mail: seu link de acesso. A Apple envia o recibo de tudo o que você compra no app e o aviso antes de um plano renovar, porque é a Apple que processa o pagamento. Não há newsletter nem lista de e-mails."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma отправляет одно: ссылку для входа. Чек за покупки в приложении и предупреждение перед продлением присылает Apple, потому что Apple принимает платёж. Рассылки нет, отписываться не от чего."
          }
        }
      }
    },
