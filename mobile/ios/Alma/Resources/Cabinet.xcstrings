    "cab.compatNeedsPerson": {
      "comment": "Compatibility with nobody to compare against.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Kompatibilität brauchst du eine zweite Person. Der ganze Vergleich wird kostenlos berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatibility needs a second birth. Add someone and the whole comparison is calculated free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver la compatibilidad, añade los datos de nacimiento de otra persona. Toda la comparación se calcula gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour voir la compatibilité, ajoute les données de naissance d’une autre personne. Toute la comparaison est calculée gratuitement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per vedere la compatibilità, aggiungi i dati di nascita di un'altra persona. Tutto il confronto è calcolato gratis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver a compatibilidade, adicione os dados de nascimento de outra pessoa. Toda a comparação é calculada de graça."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совместимости нужно второе рождение. Добавь человека — и всё сравнение рассчитается целиком и бесплатно."
          }
        }
      }
    },
