    "cab.managedByApple": {
      "comment": "Why cancelling happens at Apple and not here.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Plan wurde im App Store gekauft — Apple verwaltet die Zahlungsmethode, und dort wird auch gekündigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plan was bought in the App Store, so Apple holds the payment method and the cancellation happens there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plan se compró en la App Store, así que Apple guarda el método de pago y la cancelación se hace allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet abonnement a été acheté dans l'App Store : Apple détient le moyen de paiement, et la résiliation se fait là-bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo piano è stato comprato nell'App Store: Apple tiene il metodo di pagamento e la disdetta si fa lì."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plano foi comprado na App Store, então a Apple guarda a forma de pagamento e o cancelamento acontece lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот план куплен в App Store, поэтому способ оплаты у Apple, и отмена происходит там."
          }
        }
      }
    },
    "cab.merchantLine": {
