    "cab.aspect.meaning.conjunction": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am selben Punkt: sie wirken als eines und verstärken einander."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Very close together: their themes blend and become stronger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el mismo punto: funcionan como una sola cosa y se amplifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au même point : ils agissent comme un seul et s'amplifient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Molto vicini: i loro temi si uniscono e diventano più intensi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No mesmo ponto: agem como uma coisa só e se amplificam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоят в одной точке: работают как одно целое и усиливают друг друга."
          }
        }
      }
    },
    "cab.aspect.meaning.opposition": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einander gegenüber: sie ziehen in verschiedene Richtungen, jedes Mal neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Across from each other: their needs can pull in different directions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfrentados: tiran en direcciones opuestas y hay que elegir cada vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face à face : ils tirent en sens inverse, et il faut choisir chaque fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di fronte: le loro esigenze possono spingere in direzioni diverse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um de frente para o outro: puxam para lados opostos, e você escolhe toda vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоят напротив: тянут в разные стороны, и выбирать приходится каждый раз."
          }
        }
      }
    },
    "cab.aspect.meaning.quincunx": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sehen einander nicht: zwei Ansprüche, die sich nicht vereinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An awkward angle: their needs often require adjustment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ven: dos exigencias que no se concilian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils ne se voient pas : deux exigences qui ne se concilient pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un angolo poco fluido: le loro esigenze richiedono spesso un aggiustamento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não se enxergam: duas exigências que não se conciliam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не видят друг друга: два требования, которые не сводятся вместе."
          }
        }
      }
    },
    "cab.aspect.meaning.sextile": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie helfen einander, wenn man etwas dafür tut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A supportive connection that becomes stronger when you act on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ayudan, si pones de tu parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils s'entraident, à condition d'y mettre du sien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un legame favorevole che diventa più forte quando lo coltivi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajudam um ao outro, se você fizer a sua parte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогают друг другу, если приложить усилие."
          }
        }
      }
    },
    "cab.aspect.meaning.square": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie stehen einander im Weg: die Stelle, an der man zurechtkommen muss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tense connection that can create pressure and motivate change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se estorban: el punto donde toca arreglárselas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils se gênent : l'endroit où il faut faire avec."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un legame teso che può creare pressione e spingere al cambiamento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrapalham um ao outro: o ponto em que você tem que dar conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мешают друг другу: то место, где приходится справляться."
          }
        }
      }
    },
    "cab.aspect.meaning.trine": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie passen leicht zusammen — so leicht, dass es selten bewusst genutzt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An easy, natural connection that may feel effortless."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encajan con facilidad, tanta que rara vez se usa a propósito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils s'accordent facilement — au point qu'on s'en sert rarement exprès."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un legame fluido e naturale che può sembrare spontaneo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaixam com facilidade — tanta que raramente se usa de propósito."
          }
        },
        "ru": {
