    "cab.guestNoteApp": {
      "comment": "A guest account, on a phone rather than in a browser.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist nicht angemeldet. Dein Horoskop lebt nur auf diesem Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are not signed in. Your chart lives on this phone only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has iniciado sesión. Tu carta solo vive en este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte connecté. Ton thème ne vit que sur ce téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai effettuato l’accesso. Accedi per ritrovare questo tema su un altro dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não entrou. Seu mapa vive só neste telefone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты не в аккаунте. Твоя карта живёт только на этом телефоне."
          }
        }
      }
    },
