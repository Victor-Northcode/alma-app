    "cab.plan.cancelWhat": {
      "comment": "Settings — plan, export, deletion.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste Abbuchung entfällt. Alles, wofür du schon bezahlt hast, bleibt bis zum Ende des Zeitraums offen — kündigen ist keine Rückerstattung, und wir nehmen dir nichts weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next charge stops. Everything you have already paid for stays open until the end of the period — cancelling is not a refund, and we are not taking anything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El próximo cobro se detiene. Todo lo que ya has pagado sigue abierto hasta el final del periodo — cancelar no es un reembolso, y no te quitamos nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prochain prélèvement n'aura pas lieu. Tout ce que tu as déjà payé reste accessible jusqu'à la fin de la période — une résiliation n'est pas un remboursement, et rien ne t'est retiré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prossimo addebito si ferma. Tutto quello che hai già pagato resta aperto fino alla fine del periodo — disdire non è un rimborso, e non ti togliamo nulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima cobrança para. Tudo o que você já pagou continua aberto até o fim do período — cancelar não é reembolso, e não tiramos nada de você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующее списание останавливается. Всё уже оплаченное остаётся открытым до конца периода — отмена не возврат, и мы ничего не забираем."
          }
        }
      }
    },
