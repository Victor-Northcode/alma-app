    "scr.chat.noChart": {
      "comment": "The same, before any birth data exists.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann ohne dein Horoskop reden, aber ich würde nur raten. Gib mir deine Geburtsdaten, dann kann ich dich lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can talk without your chart, but I would only be guessing. Give me your birth data and I can read you instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedo hablar sin tu carta, pero solo estaría adivinando. Dame tus datos de nacimiento y podré leerte de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je peux parler sans ton thème, mais je ne ferais que deviner. Donne-moi tes données de naissance et je pourrai te lire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso parlare senza il tuo tema, ma starei solo indovinando. Dammi i tuoi dati di nascita e potrò leggerti davvero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso conversar sem seu mapa, mas estaria só adivinhando. Me dê seus dados de nascimento e poderei ler você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я могу разговаривать и без твоей карты, но это было бы гаданием. Дай мне данные рождения — и я смогу тебя читать."
          }
        }
      }
    },
    "scr.chat.offline": {
      "comment": "No network, in Alma's voice rather than as a status.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich komme gerade nicht an dein Horoskop. Deine Frage steht noch da — versuch es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I cannot reach your chart just now. Your question is still in the box — try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no consigo llegar a tu carta. Tu pregunta sigue escrita: inténtalo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n'arrive pas à atteindre ton thème pour l'instant. Ta question est toujours là — réessaie dans un moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo momento non riesco a raggiungere il tuo tema. La tua domanda è ancora lì: riprova tra un istante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consigo chegar ao seu mapa agora. Sua pergunta continua aí — tente de novo em um instante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямо сейчас я не дотягиваюсь до твоей карты. Твой вопрос на месте — попробуй ещё раз через минуту."
          }
        }
      }
    },
    "scr.chat.opening": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag mich alles über dein Horoskop. Ich antworte aus dem, was darin steht — und sage dir, wenn es keine Antwort hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask me anything about your chart. I answer from what is in it, and I tell you when it has no answer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntame lo que quieras sobre tu carta. Respondo desde lo que hay en ella, y te digo cuando no tiene respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande-moi ce que tu veux sur ton thème. Je réponds à partir de ce qu'il contient, et je te dis quand il n'a pas de réponse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedimi qualsiasi cosa sul tuo tema. Rispondo da ciò che c'è dentro, e ti dico quando non ha una risposta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte o que quiser sobre o seu mapa. Respondo a partir do que está nele, e digo quando ele não tem resposta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спроси меня о чём угодно в твоей карте. Я отвечаю из того, что в ней есть, и говорю, когда ответа там нет."
          }
        }
      }
    },
    "scr.chat.outOfQuestions": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine verfügbaren Fragen sind vorerst aufgebraucht. Mit einem aktiven Abo kannst du weitermachen; es enthält 30 Fragen pro Monat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ve used the questions available for now. With an active subscription, you can continue; it includes 30 questions each month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has usado las preguntas disponibles por ahora. Con una suscripción activa puedes continuar; incluye 30 preguntas al mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as utilisé les questions disponibles pour le moment. Avec un abonnement actif, tu peux continuer ; il inclut 30 questions par mois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ora hai usato tutte le domande disponibili. Con un abbonamento attivo puoi continuare; include 30 domande al mese."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você usou as perguntas disponíveis por enquanto. Com uma assinatura ativa, pode continuar; ela inclui 30 perguntas por mês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступные вопросы закончились. В подписке — 25 вопросов в месяц."
          }
        }
      }
    },
