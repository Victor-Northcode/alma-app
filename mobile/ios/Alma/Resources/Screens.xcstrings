    "scr.people.removeWhat": {
      "comment": "What removing actually costs.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Geburtsdaten werden gelöscht — und damit alle daraus erstellten Kompatibilitätsdeutungen. Bezahlte Deutungen können nicht Wort für Wort neu erstellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their birth goes, and so does every compatibility reading written from it. Readings you paid for cannot be written again word for word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su nacimiento se borra, y con él toda lectura de compatibilidad escrita a partir de él. Las lecturas que pagaste no pueden volver a escribirse palabra por palabra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses données de naissance sont supprimées — ainsi que toutes les interprétations de compatibilité créées à partir de ces données. Les interprétations payées ne peuvent pas être recréées mot pour mot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina i suoi dati di nascita e ogni lettura di compatibilità basata su di essi. Le letture pagate potrebbero non essere ricreate parola per parola."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nascimento dessa pessoa some, e com ele toda leitura de compatibilidade escrita a partir dele. Leituras pagas não podem ser reescritas palavra por palavra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уйдут их данные рождения — и каждое чтение совместимости, написанное из них. Оплаченные чтения нельзя написать заново слово в слово."
          }
        }
      }
    },
