    "scr.journey.freeNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles oben ist berechnet, und Berechnungen sind immer kostenlos. Es bleibt deins, ob du weiterliest oder nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything above is calculated, and calculations are always free. It stays yours whether you read further or not."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados de arriba siguen siendo gratis, decidas continuar o no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats ci-dessus restent gratuits, que tu continues ou non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I risultati qui sopra restano gratuiti, anche se decidi di non continuare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resultados acima continuam grátis, mesmo que você não continue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результаты выше останутся бесплатными, даже если ты не продолжишь."
          }
        }
      }
    },
