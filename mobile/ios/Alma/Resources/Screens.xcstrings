    "scr.empty.exampleNote": {
      "comment": "The sentence under the worked example.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Satz, den Alma schreibt, nennt die Position, aus der er gelesen wurde — wie oben. Nichts ist eine Vorhersage, und nichts wird gezeigt, was nicht berechnet wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every sentence Alma writes names the placement it was read from, like the one above. Nothing is a prediction, and nothing is shown that was not calculated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada frase que escribe Alma nombra la posición de la que se leyó, como la de arriba. Nada es una predicción, y no se muestra nada que no se haya calculado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque phrase qu'Alma écrit nomme la position dont elle est tirée, comme celle ci-dessus. Rien n'est une prédiction, et rien n'est montré qui n'ait été calculé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni frase che Alma scrive nomina la posizione da cui è stata letta, come quella sopra. Niente è una previsione, e non si mostra nulla che non sia calcolato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada frase que Alma escreve nomeia a posição de onde foi lida, como a de cima. Nada é previsão, e nada é mostrado sem ter sido calculado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое предложение Alma называет позицию, из которой оно прочитано, — как строка выше. Здесь нет предсказаний, и не показывается ничего, что не было рассчитано."
          }
        }
      }
    },
    "scr.empty.exampleTag": {
      "comment": "Marks the sample citation as a sample, not this person's chart.",
