    "scr.addPerson.lead": {
      "comment": "What is being asked for and why.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselben fünf Angaben, die dein eigenes Horoskop brauchte. Ohne die Geburtsminute läuft der Vergleich trotzdem, mit weniger Faktoren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add their name, birth date, birthplace and birth time if known. Without an exact time, Alma can still compare fewer chart factors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mismas cinco cosas que necesitó tu carta. Sin el minuto de nacimiento la comparación se hace igual, con menos factores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mêmes cinq choses qu'il fallait pour ton thème. Sans la minute de naissance la comparaison fonctionne quand même, sur moins de facteurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi nome, data e luogo di nascita, più l’ora se la conosci. Senza un’ora esatta, Alma può comunque confrontare meno elementi del tema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mesmas cinco coisas que seu mapa precisou. Sem o minuto de nascimento a comparação ainda funciona, com menos fatores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужны имя, дата и место рождения; время — если известно. Без точного времени сравнение тоже работает, но учитывает меньше факторов."
          }
        }
      }
    },
