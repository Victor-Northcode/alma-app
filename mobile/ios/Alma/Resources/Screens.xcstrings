    "scr.signIn.privacy": {
      "comment": "What we do with the address.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir nutzen deine Adresse für den Anmeldelink und für nichts anderes. Es gibt keinen Newsletter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use your address for the sign-in link and nothing else. There is no newsletter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usamos tu dirección para el enlace de acceso y nada más. No hay boletín."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous utilisons ton adresse pour le lien de connexion et rien d'autre. Il n'y a pas de newsletter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usiamo il tuo indirizzo per il link di accesso e nient'altro. Non c'è newsletter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usamos seu endereço para o link de acesso e nada mais. Não há newsletter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес нужен только для ссылки на вход — больше ни для чего. Рассылки нет."
          }
        }
      }
    },
    "scr.signIn.reason1": {
      "comment": "Why to sign in.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Horoskop überlebt ein neues Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chart survives a new phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu carta sobrevive a un teléfono nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton thème survit à un nouveau téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo tema sopravvive a un telefono nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu mapa sobrevive a um telefone novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоя карта переживёт новый телефон."
          }
        }
      }
    },
    "scr.signIn.reason2": {
      "comment": "Why to sign in — the restore case, which is the one that costs money.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles Gekaufte lässt sich wiederherstellen. Ein Kauf gehört zu dem Konto, mit dem er zuerst verknüpft wurde — melde dich also vor einer Neuinstallation an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything you bought can be restored. A purchase belongs to the account that claimed it first, so sign in before you reinstall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que compraste se puede restaurar. Una compra pertenece a la cuenta que la reclamó primero, así que inicia sesión antes de reinstalar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous tes achats peuvent être restaurés. Un achat appartient au compte auquel il a été associé en premier ; connecte-toi donc avant de réinstaller l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che hai comprato può essere ripristinato. Un acquisto appartiene all'account che lo ha reclamato per primo, quindi accedi prima di reinstallare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você comprou pode ser restaurado. Uma compra pertence à conta que a reivindicou primeiro, então entre antes de reinstalar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё купленное можно восстановить. Покупка принадлежит аккаунту, который забрал её первым, — войди до переустановки."
          }
        }
      }
    },
    "scr.signIn.reason3": {
      "comment": "Why to sign in.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt kein Passwort. Und wird nie eines geben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no password. There never will be."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay contraseña. Nunca la habrá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de mot de passe. Il n'y en aura jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è password. Non ci sarà mai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há senha. Nunca haverá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароля нет. И не будет."
          }
        }
      }
    },
    "scr.signIn.sendLink": {
      "comment": "Button that sends the passwordless link.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schick mir einen Link"
