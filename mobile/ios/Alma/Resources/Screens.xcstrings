    "scr.people.consent": {
      "comment": "Whose birth data this is. The terms ask; this says it at the point of entry.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind ihre Geburtsdaten, nicht deine. Frag sie vorher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is their birth data, not yours. Ask them first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son sus datos de nacimiento, no los tuyos. Pídeselo antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont leurs données de naissance, pas les tiennes. Demande-leur d'abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono i loro dati di nascita, non i tuoi. Chiedi prima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados de nascimento são deles, não seus. Pergunte antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это их данные рождения, не твои. Сначала спроси у них разрешения."
          }
        }
      }
    },
    "scr.people.eyebrow": {
      "comment": "Eyebrow above the people list.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Partnerschaft"
          }
        },
        "en": {
