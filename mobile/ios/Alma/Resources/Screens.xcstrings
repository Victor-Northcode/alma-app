    "scr.signIn.lead": {
      "comment": "What signing in actually does. It attaches; it does not replace.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Anmeldung wird deine E-Mail-Adresse mit deinem bestehenden Konto verknüpft. Deine gelesenen Inhalte und Käufe bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in links your email address to your existing account. Nothing you’ve read or bought is lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión vincula tu correo electrónico a la cuenta que ya tienes. No perderás nada de lo que hayas leído o comprado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion associe ton adresse e-mail au compte que tu as déjà. Tu ne perds rien de ce que tu as lu ou acheté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso collega il tuo indirizzo email all’account che hai già. Non perdi nulla di ciò che hai letto o acquistato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao entrar, seu e-mail fica vinculado à conta que você já tem. Nada do que você leu ou comprou é perdido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход привязывает адрес почты к аккаунту, который у тебя уже есть. Ничего из прочитанного и купленного не потеряется."
          }
        }
      }
    },
    "scr.signIn.linkSent": {
      "comment": "After it has been sent.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh in deinem Posteingang nach. Der Link meldet dich an und läuft bald ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your inbox. The link signs you in and expires shortly."
          }
        },
        "es": {
          "stringUnit": {
