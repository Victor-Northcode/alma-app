          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "compatibilité"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "affinità"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "compatibilidade"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "совместимость"
          }
        }
      }
    },
    "scr.people.lead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kompatibilitätsanalyse vergleicht dein Horoskop mit dem einer anderen Person. Der Vergleich wird immer vollständig berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatibility compares your chart against somebody else's. The comparison itself is always calculated in full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compatibilidad compara tu carta con la de otra persona. La comparación siempre se calcula completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La compatibilité compare ton thème à celui de quelqu'un d'autre. La comparaison est toujours calculée en entier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'affinità confronta il tuo tema con quello di un'altra persona. Il confronto è sempre calcolato per intero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compatibilidade compara o seu mapa com o de outra pessoa. A comparação é sempre calculada por inteiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совместимость сравнивает твою карту с чьей-то ещё. Само сравнение всегда рассчитывается целиком и бесплатно."
          }
        }
      }
    },
