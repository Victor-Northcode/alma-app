<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  This file sits *outside* the `Alma/` folder on purpose.

  `Alma/` is a file-system synchronized group: everything inside it is added to
  the target automatically, and a plist inside it would be copied into the app
  bundle as a stray resource beside the real one. Keeping it here means the
  folder that agents add screens to contains only things that are genuinely
  part of the app.

  It is a real file rather than GENERATE_INFOPLIST_FILE because three of the
  keys below have no INFOPLIST_KEY_ equivalent: the ATS exception that lets a
  simulator build talk to the backend over plain HTTP on localhost, the API
  base that varies by configuration, and the list of languages the store
  listing is expected to match.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Alma</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!--
	  The six languages the web app ships. Declared explicitly so that a device
	  set to any of them gets the app in that language even before the String
	  Catalog has been compiled for a new locale, and so the App Store listing
	  reads the same six from the binary rather than from a form somebody filled
	  in by hand.
	-->
	<!--
	  The Google OAuth iOS client id. Empty means the Google button is not
	  shown. The owner creates the client in Google Cloud Console and pastes
	  the id here; no URL type is needed — ASWebAuthenticationSession owns the
	  callback scheme itself.
	-->
	<key>GIDClientID</key>
	<string></string>

	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
		<string>de</string>
		<string>it</string>
		<string>fr</string>
		<string>pt-BR</string>
		<string>ru</string>
	</array>

	<!--
	  Night is the canvas, not a dark theme over a light design — so the app has
	  one appearance and the system is told, rather than every view being
	  written twice. This also keeps system-drawn surfaces (the keyboard, share
	  sheets, alerts) from arriving in white on top of the night.
	-->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchNight</string>
	</dict>

	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- No custom cryptography, so the export-compliance question is answered
	     once here instead of on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!--
	  Where the backend is. A build setting rather than a constant in Swift, so
	  that pointing a build at staging is a configuration change and not a code
	  change — Debug carries http://localhost:8018, Release the production host.
	-->
	<key>ALMAAPIBase</key>
	<string>$(ALMA_API_BASE)</string>

	<!--
	  App Transport Security refuses plain HTTP, and the development backend
	  runs on http://localhost:8018. The exception is scoped to localhost and to
	  127.0.0.1 alone: a blanket NSAllowsArbitraryLoads would ship to the store
	  and would have to be justified in review, and it would silently permit an
	  unencrypted connection to a *real* host the day someone typos the base URL.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
