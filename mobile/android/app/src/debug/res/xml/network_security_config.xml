<?xml version="1.0" encoding="utf-8"?>
<!--
  One host, cleartext, debug builds only.

  `cleartextTrafficPermitted="false"` on base-config is not the platform
  default doing the work — it is stated so that the exception below reads as an
  exception. Everything except the emulator's route to the host machine is
  still refused in this build.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- The host machine, as the Android emulator sees it. `localhost`
             inside the emulator is the emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
