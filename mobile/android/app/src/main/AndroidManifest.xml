<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Play Billing will not connect without it, and it is a normal
         permission: no runtime prompt, no privacy surface. -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- The daily.

         Declared, and requested at exactly one moment: after the person has
         turned the setting on, never at launch. Android 13 removed the
         second chance — after a denial the system does not prompt again until
         the app is reinstalled or its target SDK is raised — so this is one
         question, asked once, for the life of the install, and the app's own
         question goes first because ours is repeatable and the platform's is
         not. `docs/PUSH.md §5.5`.

         On API 32 and below the permission does not exist and notifications
         are allowed by default; nothing here needs a maxSdkVersion, because
         requesting a permission the platform does not know about is a no-op
         that the compat library already handles. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Touch.

         `AlmaHaptics` reaches the vibrator through `Vibrator.vibrate`, and that
         call is permission-checked: without this line the system throws
         `SecurityException` and the process dies. It killed the app at the last
         step of onboarding — the ceremony ticks once per system as it lights
         up — so the very first thing a new Android user did was watch Alma
         vanish. Found on a device, not in a test: the unit tests never touch a
         real vibrator, and the emulator was missing until today.

         A normal permission: granted at install, no runtime prompt, no privacy
         surface, nothing to disclose in either store questionnaire. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".AlmaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Alma">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Alma"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The magic link. Signing in is an email round trip on purpose —
                 no password ever exists — so the app has to be the thing that
                 opens when the link is tapped. `autoVerify` makes it silent
                 once assetlinks.json is published for the host; until then the
                 chooser appears, which is a degraded flow rather than a
                 broken one. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- `/sign-in`, because that is the path `alma/mail.py` puts in
                     the letter: `f"{config.web_url}/sign-in?token={token}"`.
                     It said `/link`, which is a path nothing sends, so every
                     emailed link opened the website instead of the app — and
                     signing in on the website attaches the identity to the
                     *browser's* guest account rather than to this phone's. -->
                <data android:scheme="https" android:host="alma.pazl.ai" android:pathPrefix="/sign-in" />
            </intent-filter>
        </activity>

        <!-- "Turn these off" and "Fewer of these", from inside a notification.

             `exported="false"`, and it matters: these two actions change a
             stored preference and delete a device row on the server, so an
             exported receiver would let any app on the phone silence Alma's
             notifications for the person who installed it. The only thing that
             needs to reach it is our own `PendingIntent`, which is explicit and
             therefore unaffected. -->
        <receiver
            android:name=".notify.DailyActionReceiver"
            android:exported="false" />
    </application>

</manifest>
