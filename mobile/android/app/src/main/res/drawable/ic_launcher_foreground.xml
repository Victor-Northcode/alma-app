        <path android:pathData="M32.4,6.4 Q35.6,22.8 41.2,26.6 Q47,30 57.8,31.9 Q47,34 41,37.4 Q35.4,41 32,57.6 Q28.6,41.2 23,37.6 Q17,34.2 6.2,32.1 Q17.2,29.8 23.2,26.4 Q28.8,22.6 32.4,6.4 Z">
            <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
                <gradient
