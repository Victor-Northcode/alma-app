<?xml version="1.0" encoding="utf-8"?>
<!--
  The XML theme exists for the moments before Compose has drawn anything: the
  splash window and the recents thumbnail. Everything after that is decided in
  ui/theme/AlmaTheme.kt.

  Its whole job is to make sure that first frame is night rather than the white
  the platform default would flash. `Theme.Material.NoActionBar` and not an
  AppCompat theme, because nothing in this app inflates an AppCompat view and
  the dependency would be carried for one XML attribute.
-->
<resources>
    <style name="Theme.Alma" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_800</item>
        <item name="android:colorBackground">@color/night_800</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
