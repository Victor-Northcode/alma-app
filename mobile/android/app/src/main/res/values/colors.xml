<?xml version="1.0" encoding="utf-8"?>
<!--
  One colour, and it is here only because the platform reads it before Compose
  runs: the window background of the very first frame. The palette proper is
  Kotlin — see ui/theme/AlmaPalette.kt — so that there is one list of colours
  rather than two that drift apart.

  (The obvious second entry, `void` for #04060E, cannot exist: aapt refuses a
  resource named after a Java keyword, and the error it gives says nothing
  about keywords being the problem.)
-->
<resources>
    <color name="night_800">#0A0D1C</color>
</resources>
