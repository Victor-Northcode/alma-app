<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Возможность «Push Notifications». Без неё iOS отвечает на
	     registerForRemoteNotifications не токеном, а отказом в
	     didFailToRegisterForRemoteNotificationsWithError — то есть ломается на
	     устройстве, а не при отправке (docs/PUSH.md §1.2).

	     Значение development, и меняться руками оно не должно: Xcode
	     подставляет production сам, когда сборку подписывают профилем
	     распространения. Отсюда и ловушка §1.8 — токены TestFlight
	     производственные, сколько бы TestFlight ни назывался тестированием, — и
	     поэтому среда, которую клиент называет серверу, берётся из
	     конфигурации сборки (kReleaseMode в push_devices.dart), а не отсюда.

	     Возможность обязана быть включена и на App ID в учётной записи Apple —
	     это шаг владельца, и до него сборка на устройство подписываться не
	     будет. Симулятору профиль не нужен. -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- Возможность «Sign in with Apple». Без неё системный лист не
	     открывается вовсе: ASAuthorizationController отвечает ошибкой 1000
	     ещё до того, как человек увидит окно, и снаружи это выглядит кнопкой,
	     которая ничего не делает.

	     Как и push, она обязана быть включена и на App ID в учётной записи
	     Apple — это шаг владельца. Симулятору профиль не нужен, и на нём лист
	     открывается; проверка на живом устройстве возможна только после того,
	     как возможность включат в консоли.

	     Отдельно от неё серверу нужен APPLE_CLIENT_ID: без него токен нечем
	     проверить, ручка /v1/auth/apple отвечает 401, и кнопка на экране не
	     появляется — сервер сам говорит клиенту, каких дверей у него нет
	     (/v1/auth/providers). -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
