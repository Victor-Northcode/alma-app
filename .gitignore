node_modules/
.next/
out/
# Secrets. `.env.local` alone was not enough: the backend reads `.env` first,
# which is where a real ANTHROPIC_API_KEY actually ends up, and an ignore rule
# that covers only the second-choice filename protects nothing.
.env
.env.*
!.env.example

backend/.venv/
backend/**/__pycache__/
backend/*.egg-info/
backend/.pytest_cache/
backend/data/*.db
# SQLite's own working files, and the snapshots a migration leaves behind.
# `*.db` alone did not cover them: WAL mode writes `-wal` and `-shm` beside the
# database, both of which are binary, both of which change on every request, and
# one of which was tracked — so `git status` was never clean and every commit
# carried a megabyte of somebody's local rows.
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.before-migration-*

# verification builds — kept out of the dev server's way
.next-verify/

# ── Mobile ──────────────────────────────────────────────────────────────────
#
# Gradle writes ~800 MB into these on a first build and none of it is source.
mobile/android/build/
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/.kotlin/
mobile/android/local.properties

# Xcode's per-user state: window positions, breakpoints, and the scheme Xcode
# autocreates. Committing it makes every developer's checkout dirty on open.
mobile/ios/**/xcuserdata/
mobile/ios/build/

# Signing material, in the belt-and-braces sense. Nothing in this project ever
# writes a keystore or a certificate inside the repository — the Android build
# reads the path and the passwords from the environment or from
# ~/.gradle/gradle.properties, and mobile/RELEASE.md says to keep the file in
# ~/keys. These rules exist for the day somebody copies one here "just for a
# minute" to get a build out. An upload key committed to a repository is a key
# that has to be rotated through Play support.
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
*.cer
*.certSigningRequest
# key.properties несёт путь к keystore и три пароля — из него build.gradle.kts
# собирает подпись релиза. В гит попадать не должен ни на одной платформе.
**/key.properties

# Push credentials, added 21 Aug 2026 when the owner set up FCM + APNs. The repo
# is now also mirrored to a PUBLIC remote, so a google-services.json or a Firebase
# service-account key committed here would be a live credential leak the instant it
# lands. `*.p8` above already covers the APNs key; these cover the ones it does not.
**/google-services.json
*-firebase-adminsdk-*.json
*.apps.googleusercontent.com.json
backend/secrets/

# macOS + editors + local agent config
.DS_Store
.claude/
.playwright-mcp/
_reference/

# runtime artefacts
backend/nohup.out
*.log

# Flutter
mobile/flutter/alma/.dart_tool/
mobile/flutter/alma/build/
mobile/flutter/alma/.flutter-plugins*
mobile/flutter/alma/ios/Pods/
mobile/flutter/alma/ios/.symlinks/
mobile/flutter/alma/android/.gradle/
mobile/flutter/alma/android/local.properties
